syntax = "v1"

info (
	title:  "搜索服务API"
	desc:   "提供帖子和用户搜索功能"
	author: "系统"
)

// 通用分页请求
type PageReq {
	Page     int64 `form:"page,default=1" validate:"min=1"`
	PageSize int64 `form:"pageSize,default=20" validate:"min=1,max=100"`
}

// 搜索帖子请求
type SearchPostReq {
	Keyword  string `form:"keyword" validate:"required"`
	PageReq
}

// 搜索帖子响应
type SearchPostResp {
	Code  int64       `json:"code"`
	Msg   string      `json:"msg"`
	Total int64       `json:"total"`
	List  []SearchPostItem `json:"list"`
}

// 搜索帖子项
type SearchPostItem {
	Id              int64  `json:"id"`
	UserId          int64  `json:"userId"`
	Username        string `json:"username"`
	Avatar          string `json:"avatar"`
	Content         string `json:"content"`
	TopicNames      []string `json:"topicNames"`
	CommentCount    int64  `json:"commentCount"`
	CollectionCount int64  `json:"collectionCount"`
	UpvoteCount     int64  `json:"upvoteCount"`
	ShareCount      int64  `json:"shareCount"`
	Visibility      int8   `json:"visibility"`
	IsTop           bool   `json:"isTop"`
	IsEssence       bool   `json:"isEssence"`
	IsLock          bool   `json:"isLock"`
	Tags            []string `json:"tags"`
	CreatedAt       int64  `json:"createdAt"`
}

// 搜索用户请求
type SearchUserReq {
	Keyword  string `form:"keyword" validate:"required"`
	PageReq
}

// 搜索用户响应
type SearchUserResp {
	Code  int64        `json:"code"`
	Msg   string       `json:"msg"`
	Total int64        `json:"total"`
	List  []SearchUserItem `json:"list"`
}

// 搜索用户项
type SearchUserItem {
	Id              int64  `json:"id"`
	Username        string `json:"username"`
	Status          int8   `json:"status"`
	IsAdmin         bool   `json:"isAdmin"`
	PostCount       int32  `json:"postCount"`
	CommentCount    int32  `json:"commentCount"`
	FollowerCount   int32  `json:"followerCount"`
	LikeCount       int32  `json:"likeCount"`
	CollectionCount int32  `json:"collectionCount"`
	LastActiveTime  int64  `json:"lastActiveTime"`
	CreatedAt       int64  `json:"createdAt"`
}

// 搜索话题请求
type SearchTopicReq {
	Keyword  string `form:"keyword" validate:"required"`
	PageReq
}

// 搜索话题响应
type SearchTopicResp {
	Code  int64          `json:"code"`
	Msg   string         `json:"msg"`
	Total int64          `json:"total"`
	List  []SearchTopicItem `json:"list"`
}

// 搜索话题项
type SearchTopicItem {
	Id        int64  `json:"id"`
	Name      string `json:"name"`
	QuoteNum  int64  `json:"quoteNum"`
	CreatedAt int64  `json:"createdAt"`
}

service search-api {
	// 搜索帖子
	@handler SearchPost
	get /search/post (SearchPostReq) returns (SearchPostResp)

	// 搜索用户
	@handler SearchUser
	get /search/user (SearchUserReq) returns (SearchUserResp)

	// 搜索话题
	@handler SearchTopic
	get /search/topic (SearchTopicReq) returns (SearchTopicResp)
}
